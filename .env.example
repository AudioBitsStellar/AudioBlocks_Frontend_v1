# Backend API used by the authenticated client and media streams
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cover art hosts allowed through next/image (#595). Origin or bare host.
# MEDIA_HOST is the backend's S3 bucket/CDN; IPFS_GATEWAY is the primary gateway
# (e.g. a Pinata dedicated gateway). https://ipfs.io is always the fallback.
NEXT_PUBLIC_MEDIA_HOST=
NEXT_PUBLIC_IPFS_GATEWAY=

# Wallet authentication and EVM contracts
# Dynamic Labs environment ID. Use a separate environment per deployment
# (local, staging, production) so test logins never mix with real users.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/your_project_id
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# Privy authentication (see docs/PRIVY_SETUP.md)
NEXT_PUBLIC_USE_PRIVY_AUTH=false
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Serve API requests from the MSW mocks in mocks/ instead of a backend (#603).
# See "Mocking the API (MSW)" in CONTRIBUTING.md.
NEXT_PUBLIC_API_MOCKING=disabled

# Feature flags for sections whose backend endpoints are not live yet (#637).
# Leave these commented out: unset flags default to OFF in production and ON in
# development/test, so a local copy of this file shows Merch, Events and
# Community voting. Uncomment a line only to override that default. Setting it
# to `false` hides the section locally (and the community route 404s).
# Accepted values: true/false, 1/0, on/off, yes/no.
# NEXT_PUBLIC_FEATURE_MERCH=false
# NEXT_PUBLIC_FEATURE_EVENTS=false
# NEXT_PUBLIC_FEATURE_COMMUNITY_VOTING=false
# NEXT_PUBLIC_FEATURE_ARTIST_PERKS=false

# Error monitoring with Sentry (optional, set only if enabled)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACE_SAMPLE_RATE=0.1
SENTRY_TRACE_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=

# Optional runtime tuning
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_SEGMENT_WRITE_KEY=
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_ENABLE_DEVTOOLS=false
NEXT_PUBLIC_CACHE_TTL=300000
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Link to the artist dashboard app shown to artists after onboarding (#596). Optional.
NEXT_PUBLIC_ARTIST_DASHBOARD_URL=

# Prefetch is OFF while the backend counts GET /song/stream as a play.
# Enable only after deploying event-based play counting; URL must contain :id.
NEXT_PUBLIC_STREAM_PLAY_COUNT_MODE=request
NEXT_PUBLIC_PLAYBACK_EVENT_URL=
