FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_API_URL=http://localhost:4000/api
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_MEDIA_HOST
ARG NEXT_PUBLIC_IPFS_GATEWAY
ARG NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_CONTRACT_ADDRESS
ARG NEXT_PUBLIC_USDC_ADDRESS
ARG NEXT_PUBLIC_USE_PRIVY_AUTH
ARG NEXT_PUBLIC_PRIVY_APP_ID
ARG NEXT_PUBLIC_ANALYTICS_ENABLED
ARG NEXT_PUBLIC_API_MOCKING
ARG NEXT_PUBLIC_API_TIMEOUT
ARG NEXT_PUBLIC_ARTIST_DASHBOARD_URL
ARG NEXT_PUBLIC_CACHE_TTL
ARG NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID
ARG NEXT_PUBLIC_DYNAMIC_ENV_ID
ARG NEXT_PUBLIC_ENABLE_DEVTOOLS
ARG NEXT_PUBLIC_FEATURE_COMMUNITY_VOTING
ARG NEXT_PUBLIC_FEATURE_EVENTS
ARG NEXT_PUBLIC_FEATURE_MERCH
ARG NEXT_PUBLIC_LOG_LEVEL
ARG NEXT_PUBLIC_PLAYBACK_EVENT_URL
ARG NEXT_PUBLIC_SEGMENT_WRITE_KEY
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_SENTRY_TRACE_SAMPLE_RATE
ARG NEXT_PUBLIC_STELLAR_NETWORK
ARG NEXT_PUBLIC_STREAM_PLAY_COUNT_MODE

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_MEDIA_HOST=$NEXT_PUBLIC_MEDIA_HOST \
    NEXT_PUBLIC_IPFS_GATEWAY=$NEXT_PUBLIC_IPFS_GATEWAY \
    NEXT_PUBLIC_DYNAMIC_ENV_ID=$NEXT_PUBLIC_DYNAMIC_ENV_ID \
    NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID \
    NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL \
    NEXT_PUBLIC_CONTRACT_ADDRESS=$NEXT_PUBLIC_CONTRACT_ADDRESS \
    NEXT_PUBLIC_USDC_ADDRESS=$NEXT_PUBLIC_USDC_ADDRESS \
    NEXT_PUBLIC_USE_PRIVY_AUTH=$NEXT_PUBLIC_USE_PRIVY_AUTH \
    NEXT_PUBLIC_PRIVY_APP_ID=$NEXT_PUBLIC_PRIVY_APP_ID \
    NEXT_PUBLIC_ANALYTICS_ENABLED=$NEXT_PUBLIC_ANALYTICS_ENABLED \
    NEXT_PUBLIC_API_MOCKING=$NEXT_PUBLIC_API_MOCKING \
    NEXT_PUBLIC_API_TIMEOUT=$NEXT_PUBLIC_API_TIMEOUT \
    NEXT_PUBLIC_ARTIST_DASHBOARD_URL=$NEXT_PUBLIC_ARTIST_DASHBOARD_URL \
    NEXT_PUBLIC_CACHE_TTL=$NEXT_PUBLIC_CACHE_TTL \
    NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=$NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID \
    NEXT_PUBLIC_DYNAMIC_ENV_ID=$NEXT_PUBLIC_DYNAMIC_ENV_ID \
    NEXT_PUBLIC_ENABLE_DEVTOOLS=$NEXT_PUBLIC_ENABLE_DEVTOOLS \
    NEXT_PUBLIC_FEATURE_COMMUNITY_VOTING=$NEXT_PUBLIC_FEATURE_COMMUNITY_VOTING \
    NEXT_PUBLIC_FEATURE_EVENTS=$NEXT_PUBLIC_FEATURE_EVENTS \
    NEXT_PUBLIC_FEATURE_MERCH=$NEXT_PUBLIC_FEATURE_MERCH \
    NEXT_PUBLIC_LOG_LEVEL=$NEXT_PUBLIC_LOG_LEVEL \
    NEXT_PUBLIC_PLAYBACK_EVENT_URL=$NEXT_PUBLIC_PLAYBACK_EVENT_URL \
    NEXT_PUBLIC_SEGMENT_WRITE_KEY=$NEXT_PUBLIC_SEGMENT_WRITE_KEY \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_SENTRY_TRACE_SAMPLE_RATE=$NEXT_PUBLIC_SENTRY_TRACE_SAMPLE_RATE \
    NEXT_PUBLIC_STELLAR_NETWORK=$NEXT_PUBLIC_STELLAR_NETWORK \
    NEXT_PUBLIC_STREAM_PLAY_COUNT_MODE=$NEXT_PUBLIC_STREAM_PLAY_COUNT_MODE

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
