{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found}.tsx",
    "app/api/**/*.ts",
    "pages/**/*.{js,jsx,ts,tsx}"
  ],
  "project": ["**/*.{js,jsx,ts,tsx}"],
  "ignore": [
    "**/*.d.ts",
    "tests/**/*",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "@types/*",
    "autoprefixer",
    "postcss",
    "tailwindcss"
  ]
}
