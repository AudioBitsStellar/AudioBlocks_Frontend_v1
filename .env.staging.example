# Staging environment reference values (#842 — OPS-03).
#
# Staging exists to verify the app against the backend's **testnet**
# deployment before anything is promoted to production. Copy this file to
# `.env.staging` (git-ignored, same as `.env.local`) and fill in the blanks,
# or pass the same variable names to `docker run -e` / your orchestrator's
# env block for the `staging` image tag described in
# docs/STAGING_PARITY_CHECKLIST.md.
#
# This file intentionally mirrors .env.example's shape so the two stay easy
# to diff — that diff *is* the parity check for config drift.

# Backend API used by the authenticated client and media streams.
# Point this at the testnet backend deployment, not production.
NEXT_PUBLIC_API_URL=https://staging-api.audioblocks.dev/api
NEXT_PUBLIC_API_BASE_URL=https://staging-api.audioblocks.dev/api
NEXT_PUBLIC_SITE_URL=https://staging.audioblocks.dev

# Cover art hosts allowed through next/image (#595).
NEXT_PUBLIC_MEDIA_HOST=
NEXT_PUBLIC_IPFS_GATEWAY=

# Stellar network — staging always runs against testnet, never public/mainnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Wallet authentication and EVM contracts — use testnet/sepolia values, and a
# Dynamic Labs environment ID dedicated to staging so test logins never mix
# with production users.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_staging_dynamic_environment_id
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/your_project_id
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# Serve API requests from the MSW mocks instead of a backend. Keep disabled
# on staging — the whole point is exercising the real testnet backend.
NEXT_PUBLIC_API_MOCKING=disabled

# Error monitoring — report to a Sentry environment tagged "staging" so
# staging noise never pollutes production alerting.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACE_SAMPLE_RATE=1.0

# Optional runtime tuning
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_ANALYTICS_ENABLED=false
